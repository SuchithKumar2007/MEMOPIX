# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── DATABASE (Railway PostgreSQL — copy the DATABASE_URL from Railway dashboard) ─
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── AUTH ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── STORAGE ─────────────────────────────────────────────────────────────────
STORAGE_LIMIT_BYTES=5000000000000
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage_data

# ─── CORS / URLS ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://memopix-tas.vercel.app
BACKEND_URL=https://your-backend.railway.app

# ─── GOOGLE OAUTH (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend.railway.app/api/auth/google/callback

# ─── SUPABASE STORAGE (optional — alternative to local storage) ───────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=memopix-private-media
